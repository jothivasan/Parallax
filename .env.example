# Parallax Environment Configuration (.env.example)
# Copy this file to .env for local development: cp .env.example .env
# All variables are optional. Parallax works out-of-the-box as a static browser
# deployment (Vercel / static hosting) with zero backend environment variables.

# Server Port for local/self-hosted Native Execution Server (Must remain 3000 in AI Studio preview)
PORT=3000

# Optional: Static vs Hybrid Deployment Mode
# - auto   (default): Uses Browser Mode by default; connects to same-origin or configured Native Execution Server when Native Mode is selected.
# - static: Pure static browser deployment (e.g. Vercel). Disables all /api/* health probes and runs public challenge tests locally in Browser Mode.
# - hybrid: Static frontend connected to an external Native Execution Server via VITE_NATIVE_EXECUTION_SERVER_URL.
VITE_DEPLOYMENT_MODE=auto

# Optional: External Native Execution Server URL
# Leave blank for static Browser Mode or same-origin local development (`npm run dev`).
# Set to an http:// or https:// origin (e.g. http://localhost:3000) to enable Native Mode compilers from a static frontend.
VITE_NATIVE_EXECUTION_SERVER_URL=
VITE_BACKEND_URL=

# Optional: External GitHub Repository Configuration
# When set, /api/github/repo (when backend is active) fetches and caches live repository metadata
# and the header/footer display direct GitHub repository links. Never place private GitHub tokens in VITE_* variables.
VITE_GITHUB_REPO=
VITE_GITHUB_REPO_URL=
DRYRUN_GITHUB_REPO=

# Optional: Cloud Authentication & Supabase Configuration
# Leave blank/false for Local-First open-source mode (no login or Supabase account required).
VITE_AUTH_PROVIDER_CONFIGURED=false
VITE_AUTH_PROVIDER_NAME=Local-First Mode
VITE_AUTH_ENDPOINT=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Internal Maintainer Console Access Key
# Used by /internal/* routes when protecting operational views.
VITE_INTERNAL_ACCESS_KEY=
